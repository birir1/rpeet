# ─── Database ──────────────────────────────────
DB_NAME=kck
DB_USER=kck
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Django ────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=kenyakorea.com,www.kenyakorea.com
CORS_ALLOWED_ORIGINS=https://kenyakorea.com,https://www.kenyakorea.com
KCK_BASE_URL=https://kenyakorea.com

# ─── Laravel ───────────────────────────────────
APP_KEY=base64:CHANGE_ME
APP_ENV=production
APP_DEBUG=false

# ─── Email ─────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=KCK <noreply@kenyakorea.com>

# ─── Monitoring ────────────────────────────────
SENTRY_DSN=

# ─── Domain (for nginx SSL) ───────────────────
DOMAIN=kenyakorea.com
