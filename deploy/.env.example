# ─── Database ──────────────────────────────────
DB_NAME=kck
DB_USER=kck
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Django ────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=kck.or.ke,www.kck.or.ke
CORS_ALLOWED_ORIGINS=https://kck.or.ke,https://www.kck.or.ke
KCK_BASE_URL=https://kck.or.ke

# ─── Laravel ───────────────────────────────────
APP_KEY=base64:CHANGE_ME
APP_ENV=production
APP_DEBUG=false

# ─── Email ─────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=KCK <noreply@kck.or.ke>

# ─── Monitoring ────────────────────────────────
SENTRY_DSN=

# ─── Domain (for nginx SSL) ───────────────────
DOMAIN=kck.or.ke
